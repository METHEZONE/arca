<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The on-demand deep-measure session reads live heart rate and writes the
	     mindful minutes it earns. Nothing here runs unless the user starts it. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
