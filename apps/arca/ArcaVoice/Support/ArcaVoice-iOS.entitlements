<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.thezone.arca.voice</string>
	</array>
	<!-- Body + focus tracking. Only the app itself asks for this; the widget and
	     share extensions deliberately keep their own entitlements without it, so
	     they don't demand a capability they never use. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
